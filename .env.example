# Firebase Configuration (.env.local format)
# Copy this file to .env.local and fill in your Firebase project details

# Firebase Project Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123def456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Development Settings
# Set to "true" to use Firebase emulator suite locally
VITE_USE_EMULATOR=false

# API Configuration
VITE_API_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CRASH_REPORTING=true

# Optional: Custom domain for Cloud Functions
# VITE_FUNCTIONS_REGION=us-central1
